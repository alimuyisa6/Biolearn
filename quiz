<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Quizzes — AliverBiopharm | Test Your Biology & Pharmacy Knowledge</title>
  <meta name="description" content="Test your biology and pharmacy knowledge with interactive quizzes. O-Level, A-Level, and Pharmacy categories. Track your progress and earn certificates." />
  <meta name="theme-color" content="#0a4f4f" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: http: 'unsafe-inline' 'unsafe-eval'; script-src 'self' https: http: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: http: 'unsafe-inline'; img-src 'self' https: http: data:; font-src 'self' https: http: data:; connect-src 'self' https: http:;" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/fontawesome.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/solid.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/brands.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Playfair Display', 'serif'],
            body: ['DM Sans', 'sans-serif'],
            mono: ['DM Mono', 'monospace'],
          },
          colors: {
            teal: {
              950: '#0a4f4f', 900: '#0e7070', 800: '#0ab5b5', 700: '#6ee7e7',
              600: '#8ef0f0', 500: '#b8f5f5', 400: '#d4fafa',
            },
            gold: { 500: '#b8873a', 400: '#e2c06a', 300: '#f0d896' },
          },
        },
      },
    }
  </script>
  <style>
    :root {
      --clr-deep-space: #eef7f7;
      --clr-cyan: #0ab5b5;
      --clr-magenta: #b8873a;
      --clr-navy-card: rgba(255, 255, 255, 0.82);
      --clr-navy-light: rgba(10, 181, 181, 0.1);
      --clr-white: #0d2e2e;
      --clr-text-dim: #2d5c5c;
      --clr-text-muted: #4a7c7c;
      --clr-border-glow: rgba(10, 181, 181, 0.22);
      --shadow-glow: 0 4px 28px rgba(10, 181, 181, 0.07);
      --shadow-magenta: 0 8px 28px rgba(184, 135, 58, 0.38);
      --shadow-card: 0 4px 28px rgba(10, 181, 181, 0.07);
      --transition-fast: 180ms ease;
      --transition-smooth: 350ms cubic-bezier(0.4,0,0.2,1);
      --max-width: 1100px;
      --font-body: 'DM Sans', sans-serif;
      --font-display: 'Playfair Display', serif;
      --radius-sm: 0.5rem;
      --radius-md: 0.85rem;
      --radius-lg: 1.4rem;
      --gradient-cyan: linear-gradient(135deg, #0ab5b5, #0e7070);
      --gradient-magenta: linear-gradient(135deg, #b8873a, #e2c06a);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--clr-deep-space);
      color: var(--clr-white);
      font-family: var(--font-body);
      overflow-x: hidden;
      max-width: 100vw;
      transition: background 0.35s, color 0.35s;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    body.dark-mode {
      --clr-deep-space: #012c2c;
      --clr-cyan: #0ab5b5;
      --clr-magenta: #c9a84c;
      --clr-navy-card: rgba(2, 82, 82, 0.45);
      --clr-navy-light: rgba(2, 82, 82, 0.25);
      --clr-white: #f9f5ee;
      --clr-text-dim: rgba(249, 245, 238, 0.7);
      --clr-text-muted: rgba(249, 245, 238, 0.45);
      --clr-border-glow: rgba(10, 181, 181, 0.25);
      --shadow-card: 0 15px 40px rgba(0, 0, 0, 0.4);
      background-image: radial-gradient(ellipse 80% 50% at 20% -10%, rgba(10,181,181,0.08) 0%, transparent 60%), radial-gradient(ellipse 60% 40% at 80% 110%, rgba(201,168,76,0.06) 0%, transparent 60%);
    }

    .skip-link {
      position: absolute;
      top: -100%;
      left: 1rem;
      z-index: 1000;
      background: var(--clr-cyan);
      color: #012c2c;
      padding: 0.65rem 1.3rem;
      border-radius: 30px;
      font-weight: 700;
      text-decoration: none;
      transition: top var(--transition-fast);
    }
    .skip-link:focus { top: 0.75rem; }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(238, 247, 247, 0.92);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border-bottom: 1px solid var(--clr-border-glow);
      transition: box-shadow var(--transition-smooth), background var(--transition-smooth);
    }
    body.dark-mode .site-header { background: rgba(1, 44, 44, 0.85); }
    .site-header.scrolled { box-shadow: var(--shadow-glow); }

    .header-container {
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 24px;
      width: 100%;
    }

    .logo-link {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--clr-white);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: -0.02em;
      transition: opacity var(--transition-fast);
    }
    .logo-link:hover { opacity: 0.88; }

    .logo-icon {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--gradient-cyan);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }

    .g-text {
      background: linear-gradient(130deg, var(--clr-cyan) 0%, var(--clr-magenta) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .main-nav { display: flex; gap: 32px; list-style: none; flex-wrap: wrap; justify-content: center; }
    .main-nav a {
      color: var(--clr-text-dim);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.88rem;
      padding-bottom: 2px;
      border-bottom: 2px solid transparent;
      transition: all var(--transition-fast);
      white-space: nowrap;
      position: relative;
    }
    .main-nav a::after {
      content: '';
      display: block;
      height: 2px;
      width: 0;
      background: var(--clr-cyan);
      transition: width 0.3s;
      border-radius: 2px;
      position: absolute;
      bottom: -2px;
      left: 0;
    }
    .main-nav a:hover, .main-nav a.active { color: var(--clr-white); }
    .main-nav a:hover::after, .main-nav a.active::after { width: 100%; }

    .theme-toggle {
      background: transparent;
      border: 1.5px solid var(--clr-cyan);
      color: var(--clr-cyan);
      font-size: 0.95rem;
      padding: 0.42rem 0.75rem;
      border-radius: 30px;
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .theme-toggle:hover { background: var(--clr-cyan); color: #fff; }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: var(--gradient-magenta);
      color: #fff;
      padding: 14px 34px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.875rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all var(--transition-fast);
      box-shadow: var(--shadow-magenta);
      letter-spacing: 0.01em;
    }
    .btn-primary:hover { transform: scale(1.04); box-shadow: 0 12px 38px rgba(184, 135, 58, 0.54); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: rgba(255, 255, 255, 0.75);
      border: 1.5px solid rgba(10, 181, 181, 0.38);
      color: var(--clr-white);
      padding: 12px 28px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.875rem;
      text-decoration: none;
      cursor: pointer;
      transition: all var(--transition-fast);
      backdrop-filter: blur(8px);
    }
    .btn-outline:hover { transform: scale(1.04); background: rgba(10, 181, 181, 0.08); }
    body.dark-mode .btn-outline { background: rgba(2, 82, 82, 0.35); }

    .card {
      background: var(--clr-navy-card);
      backdrop-filter: blur(12px);
      border: 1px solid var(--clr-border-glow);
      border-radius: var(--radius-lg);
      padding: 1.8rem;
      box-shadow: var(--shadow-card);
      transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
      height: fit-content;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: rgba(184, 135, 58, 0.45);
      box-shadow: 0 20px 56px rgba(10, 181, 181, 0.14);
    }

    .section { max-width: var(--max-width); margin: 0 auto; padding: 80px 24px; width: 100%; flex: 1; }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900;
      color: var(--clr-white);
      margin-bottom: 1rem;
      text-align: center;
      letter-spacing: -0.025em;
      line-height: 1.2;
    }
    .section-subtitle { text-align: center; color: var(--clr-text-dim); font-size: 0.95rem; max-width: 480px; margin: 12px auto 2.5rem; line-height: 1.6; }
    .sec-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: var(--clr-cyan);
      margin-bottom: 14px;
      display: block;
      text-align: center;
      text-transform: uppercase;
    }

    .quiz-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-bottom: 2rem; }

    .quiz-card { cursor: pointer; }
    .quiz-card .difficulty-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .difficulty-easy { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .difficulty-medium { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .difficulty-hard { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }

    .category-filter {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 2rem;
    }
    .category-pill {
      padding: 8px 20px;
      border-radius: 30px;
      border: 1.5px solid var(--clr-border-glow);
      background: transparent;
      color: var(--clr-text-dim);
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 500;
      transition: all var(--transition-fast);
      white-space: nowrap;
    }
    .category-pill:hover { border-color: var(--clr-cyan); color: var(--clr-cyan); }
    .category-pill.active { background: var(--clr-cyan); border-color: var(--clr-cyan); color: #fff; }

    .quiz-taking-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .question-card {
      background: var(--clr-navy-card);
      backdrop-filter: blur(12px);
      border: 1px solid var(--clr-border-glow);
      border-radius: var(--radius-lg);
      padding: 2rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-card);
    }

    .option-btn {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      padding: 14px 18px;
      margin-bottom: 8px;
      border-radius: 12px;
      border: 1.5px solid var(--clr-border-glow);
      background: rgba(10, 181, 181, 0.03);
      color: var(--clr-white);
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 0.9rem;
      text-align: left;
      transition: all var(--transition-fast);
    }
    .option-btn:hover:not(:disabled) { border-color: var(--clr-cyan); background: rgba(10, 181, 181, 0.08); }
    .option-btn.selected { border-color: var(--clr-cyan); background: rgba(10, 181, 181, 0.15); }
    .option-btn.correct { border-color: #10b981; background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .option-btn.incorrect { border-color: #ef4444; background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .option-btn:disabled { cursor: not-allowed; opacity: 0.8; }
    .option-letter {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--clr-navy-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background: rgba(10, 181, 181, 0.12);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 2rem;
    }
    .progress-fill {
      height: 100%;
      border-radius: 99px;
      background: var(--gradient-cyan);
      transition: width 0.4s ease;
    }

    .timer-display {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 6px 16px;
      border-radius: 30px;
      background: rgba(10, 181, 181, 0.1);
      font-family: 'DM Mono', monospace;
      font-size: 0.9rem;
      color: var(--clr-cyan);
    }
    .timer-warning { color: #f59e0b; animation: pulse 1s infinite; }

    .result-card {
      text-align: center;
      padding: 3rem 2rem;
    }
    .result-score {
      font-family: var(--font-display);
      font-size: 4rem;
      font-weight: 900;
      color: var(--clr-cyan);
    }
    .result-remark {
      font-size: 1.1rem;
      color: var(--clr-text-dim);
      margin: 1rem 0;
      font-style: italic;
    }

    .explanation-box {
      background: rgba(10, 181, 181, 0.05);
      border: 1px solid var(--clr-border-glow);
      border-radius: 12px;
      padding: 1rem 1.2rem;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--clr-text-dim);
      line-height: 1.7;
    }
    .explanation-box strong { color: var(--clr-cyan); }

    .auth-required-overlay {
      text-align: center;
      padding: 4rem 2rem;
    }

    .footer-fat {
      background: rgba(255, 255, 255, 0.92);
      border-top: 1px solid var(--clr-border-glow);
      padding: 2rem 1.5rem;
      margin-top: auto;
      width: 100%;
      text-align: center;
    }
    body.dark-mode .footer-fat { background: #011f1f; border-top: 2px solid rgba(10, 181, 181, 0.3); }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    @media (max-width: 768px) {
      .main-nav { display: none; }
      .section { padding: 40px 16px; }
      .quiz-grid { grid-template-columns: 1fr; }
      .result-score { font-size: 3rem; }
      .category-pill { font-size: 0.75rem; padding: 6px 14px; }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="site-header" id="site-header">
    <div class="header-container">
      <a href="/" class="logo-link">
        <div class="logo-icon">
          <svg width="18" height="18" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082"/></svg>
        </div>
        Aliver<span class="g-text">Biopharm</span>
      </a>
      <nav><ul class="main-nav" id="main-nav"></ul></nav>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
    </div>
  </header>

  <main id="main-content" class="section">
    <span class="sec-label">ASSESSMENTS</span>
    <h1 class="section-title">Biology & Pharmacy Quizzes</h1>
    <p class="section-subtitle">Test your knowledge with interactive quizzes. Sign in to track your progress and earn achievements.</p>

    <div class="category-filter" id="category-filter">
      <button class="category-pill active" data-category="all">All Categories</button>
    </div>

    <div id="quiz-content"></div>
  </main>

  <footer class="footer-fat">
    <p style="font-size:0.75rem;color:var(--clr-text-muted);">&copy; <span id="current-year"></span> AliverBiopharm. All rights reserved.</p>
  </footer>

  <script>
    const API_BASE = '/api/query';
    let currentUser = null;
    let currentQuiz = null;
    let quizQuestions = [];
    let currentQuestionIndex = 0;
    let userAnswers = [];
    let quizTimer = null;
    let timeRemaining = 0;
    let quizStartTime = null;
    let activeCategory = 'all';

    const PASS_REMARKS = [
      "Outstanding! You're a natural at this!",
      "Excellent work! Your knowledge is impressive!",
      "Great job! You really know your stuff!",
      "Well done! Keep up the fantastic work!",
      "Brilliant! You're mastering this subject!",
      "Superb performance! You should be proud!",
      "Fantastic! Your hard work is paying off!",
      "Remarkable! You're on the path to expertise!"
    ];

    const FAIL_REMARKS = [
      "Don't worry, every expert was once a beginner. Try again tomorrow!",
      "Keep studying! Understanding comes with practice. Come back tomorrow!",
      "You're making progress just by trying. Review and retry tomorrow!",
      "Learning is a journey. Take some time to review and try again tomorrow!",
      "Mistakes help us learn. Study the explanations and come back tomorrow!"
    ];

    function esc(t) { if (!t) return ''; return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }

    function getRandomRemark(passed) {
      const list = passed ? PASS_REMARKS : FAIL_REMARKS;
      return list[Math.floor(Math.random() * list.length)];
    }

    async function apiCall(action, params = {}) {
      const headers = { 'Content-Type': 'application/json' };
      const token = localStorage.getItem('sb-token');
      if (token) headers['Authorization'] = 'Bearer ' + token;
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 12000);
      try {
        const res = await fetch(API_BASE, { method: 'POST', headers, body: JSON.stringify({ action, ...params }), signal: controller.signal });
        clearTimeout(timeout);
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Request failed');
        return json.data !== undefined ? json.data : json;
      } catch (err) { clearTimeout(timeout); throw err; }
    }

    async function checkAuth() {
      const token = localStorage.getItem('sb-token');
      if (!token || token.length < 20) return null;
      try {
        const data = await apiCall('get_user');
        return data?.user || null;
      } catch(e) { return null; }
    }

    function shuffleArray(arr) {
      const shuffled = [...arr];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    }

    async function loadNavigation() {
      try {
        const sections = await apiCall('get_all_site_sections');
        if (sections && sections.navigation) {
          const links = sections.navigation.links || [];
          document.getElementById('main-nav').innerHTML = links.map(l => '<li><a href="' + esc(l.href) + '">' + esc(l.label) + '</a></li>').join('');
        }
      } catch(e) {}
    }

    async function loadQuizzes() {
      currentUser = await checkAuth();
      const container = document.getElementById('quiz-content');
      
      try {
        const quizzes = await apiCall('get_quizzes', { category: activeCategory !== 'all' ? activeCategory : undefined });
        
        if (!quizzes || !quizzes.length) {
          container.innerHTML = '<div class="auth-required-overlay"><i class="fa-solid fa-flask text-5xl" style="color:var(--clr-cyan);margin-bottom:1.5rem;"></i><h2 style="font-family:\'Playfair Display\',serif;font-size:1.5rem;color:var(--clr-white);margin-bottom:0.5rem;">No Quizzes Available</h2><p style="color:var(--clr-text-dim);">Check back soon for new quizzes in this category.</p></div>';
          return;
        }

        const categories = [...new Set(quizzes.map(q => q.category).filter(Boolean))];
        const catFilter = document.getElementById('category-filter');
        catFilter.innerHTML = '<button class="category-pill' + (activeCategory === 'all' ? ' active' : '') + '" data-category="all">All Categories</button>' + categories.map(c => '<button class="category-pill' + (activeCategory === c ? ' active' : '') + '" data-category="' + esc(c) + '">' + esc(c) + '</button>').join('');
        
        catFilter.querySelectorAll('.category-pill').forEach(btn => {
          btn.addEventListener('click', () => {
            activeCategory = btn.dataset.category;
            catFilter.querySelectorAll('.category-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            loadQuizzes();
          });
        });

        container.innerHTML = '<div class="quiz-grid">' + quizzes.map(q => {
          const userProgress = q.user_progress;
          const isLocked = userProgress && !userProgress.passed && isSameDay(new Date(userProgress.completed_at), new Date());
          const hasPassed = userProgress && userProgress.passed;
          
          let statusHTML = '';
          if (hasPassed) {
            statusHTML = '<span style="color:#10b981;font-size:0.8rem;"><i class="fa-solid fa-circle-check"></i> Passed (' + userProgress.percentage + '%)</span>';
          } else if (isLocked) {
            statusHTML = '<span style="color:#f59e0b;font-size:0.8rem;"><i class="fa-solid fa-lock"></i> Try again tomorrow</span>';
          } else if (userProgress) {
            statusHTML = '<span style="color:var(--clr-text-muted);font-size:0.8rem;"><i class="fa-solid fa-rotate"></i> Retry available</span>';
          }
          
          return '<div class="card quiz-card" onclick="' + (isLocked ? '' : 'startQuiz(' + q.id + ', \'' + esc(q.title) + '\', ' + (q.total_points || 10) + ', ' + (q.time_limit || 600) + ')') + '" style="' + (isLocked ? 'opacity:0.6;cursor:not-allowed;' : '') + '">' +
            '<div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem;">' +
              '<span class="difficulty-badge difficulty-' + esc(q.difficulty || 'medium') + '">' + esc(q.difficulty || 'Medium') + '</span>' +
              (statusHTML ? statusHTML : '<span style="color:var(--clr-text-muted);font-size:0.8rem;">' + esc(q.total_points || 10) + ' pts</span>') +
            '</div>' +
            '<h3 style="font-family:\'Playfair Display\',serif;font-weight:700;font-size:1.15rem;color:var(--clr-white);margin-bottom:0.5rem;">' + esc(q.title) + '</h3>' +
            '<p style="font-size:0.84rem;color:var(--clr-text-dim);margin-bottom:0.75rem;">' + esc(q.description || '') + '</p>' +
            '<div style="display:flex;gap:1rem;font-size:0.75rem;color:var(--clr-text-muted);">' +
              '<span><i class="fa-regular fa-clock"></i> ' + Math.floor((q.time_limit || 600) / 60) + ' min</span>' +
              '<span><i class="fa-regular fa-circle-question"></i> ' + (Array.isArray(q.questions) ? q.questions.length : 0) + ' questions</span>' +
            '</div>' +
          '</div>';
        }).join('') + '</div>';
        
        if (!currentUser) {
          container.insertAdjacentHTML('beforeend', '<div class="auth-required-overlay" style="margin-top:2rem;border-top:1px solid var(--clr-border-glow);padding-top:2rem;"><p style="color:var(--clr-text-dim);margin-bottom:1rem;">Sign in to track your quiz progress and unlock achievements.</p><button class="btn-primary" onclick="showAuthForm(\'signin\')"><i class="fa-solid fa-right-to-bracket"></i> Sign In to Start</button></div>');
        }
      } catch(err) {
        container.innerHTML = '<p style="text-align:center;color:var(--clr-magenta);">Failed to load quizzes. Please try again.</p>';
      }
    }

    function isSameDay(d1, d2) {
      return d1.getFullYear() === d2.getFullYear() && d1.getMonth() === d2.getMonth() && d1.getDate() === d2.getDate();
    }

    async function startQuiz(quizId, title, totalPoints, timeLimit) {
      if (!currentUser) {
        showAuthForm('signin');
        return;
      }

      try {
        const quizData = await apiCall('get_quiz', { id: quizId });
        if (!quizData || !quizData.questions) {
          alert('Quiz not available.');
          return;
        }

        const questions = Array.isArray(quizData.questions) ? quizData.questions : [];
        if (!questions.length) {
          alert('No questions in this quiz.');
          return;
        }

        currentQuiz = { id: quizId, title, totalPoints: totalPoints || quizData.total_points || 10 };
        quizQuestions = shuffleArray(questions);
        currentQuestionIndex = 0;
        userAnswers = [];
        timeRemaining = timeLimit || quizData.time_limit || 600;
        quizStartTime = new Date();

        renderQuizTaking();
        startTimer();
      } catch(err) {
        alert('Failed to load quiz: ' + err.message);
      }
    }

    function renderQuizTaking() {
      const container = document.getElementById('quiz-content');
      const q = quizQuestions[currentQuestionIndex];
      const progress = ((currentQuestionIndex) / quizQuestions.length) * 100;
      
      let optionsHTML = '';
      if (q.options && Array.isArray(q.options)) {
        const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
        optionsHTML = q.options.map((opt, i) => {
          const isAnswered = userAnswers[currentQuestionIndex] !== undefined;
          const isSelected = userAnswers[currentQuestionIndex] === i;
          const isCorrect = q.correct === i;
          let cls = '';
          if (isAnswered) {
            if (isCorrect) cls = 'correct';
            else if (isSelected) cls = 'incorrect';
          } else if (isSelected) {
            cls = 'selected';
          }
          return '<button class="option-btn ' + cls + '" onclick="selectAnswer(' + i + ')" ' + (isAnswered ? 'disabled' : '') + '>' +
            '<span class="option-letter">' + letters[i] + '</span>' +
            '<span>' + esc(opt) + '</span>' +
            (isAnswered && isCorrect ? '<i class="fa-solid fa-check" style="color:#10b981;margin-left:auto;"></i>' : '') +
            (isAnswered && isSelected && !isCorrect ? '<i class="fa-solid fa-xmark" style="color:#ef4444;margin-left:auto;"></i>' : '') +
          '</button>';
        }).join('');
      }

      const minutes = Math.floor(timeRemaining / 60);
      const seconds = timeRemaining % 60;
      const timerClass = timeRemaining < 60 ? ' timer-warning' : '';

      container.innerHTML = '<div class="quiz-taking-container">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:0.75rem;">' +
          '<h2 style="font-family:\'Playfair Display\',serif;font-size:1.3rem;color:var(--clr-white);">' + esc(currentQuiz.title) + '</h2>' +
          '<div class="timer-display' + timerClass + '" id="timer-display"><i class="fa-regular fa-clock"></i> <span id="timer-text">' + String(minutes).padStart(2,'0') + ':' + String(seconds).padStart(2,'0') + '</span></div>' +
        '</div>' +
        '<div class="progress-bar"><div class="progress-fill" style="width:' + progress + '%;"></div></div>' +
        '<p style="font-size:0.8rem;color:var(--clr-text-muted);margin-bottom:1rem;">Question ' + (currentQuestionIndex + 1) + ' of ' + quizQuestions.length + '</p>' +
        '<div class="question-card">' +
          '<h3 style="font-family:\'Playfair Display\',serif;font-weight:700;font-size:1.15rem;color:var(--clr-white);margin-bottom:1.2rem;line-height:1.5;">' + esc(q.question) + '</h3>' +
          optionsHTML +
        '</div>' +
        '<div style="display:flex;gap:0.75rem;justify-content:space-between;">' +
          '<button class="btn-outline" onclick="prevQuestion()" ' + (currentQuestionIndex === 0 ? 'disabled' : '') + '><i class="fa-solid fa-arrow-left"></i> Previous</button>' +
          (currentQuestionIndex < quizQuestions.length - 1 ? '<button class="btn-primary" id="next-btn" onclick="nextQuestion()"' + (userAnswers[currentQuestionIndex] === undefined ? ' disabled' : '') + '>Next <i class="fa-solid fa-arrow-right"></i></button>' : '<button class="btn-primary" id="submit-btn" onclick="submitQuiz()"' + (userAnswers[currentQuestionIndex] === undefined ? ' disabled' : '') + '>Submit Quiz <i class="fa-solid fa-check"></i></button>') +
        '</div>' +
      '</div>';
    }

    function selectAnswer(index) {
      if (userAnswers[currentQuestionIndex] !== undefined) return;
      userAnswers[currentQuestionIndex] = index;
      renderQuizTaking();
      
      const nextBtn = document.getElementById('next-btn');
      const submitBtn = document.getElementById('submit-btn');
      if (nextBtn) nextBtn.disabled = false;
      if (submitBtn) submitBtn.disabled = false;
    }

    function nextQuestion() {
      if (currentQuestionIndex < quizQuestions.length - 1) {
        currentQuestionIndex++;
        renderQuizTaking();
      }
    }

    function prevQuestion() {
      if (currentQuestionIndex > 0) {
        currentQuestionIndex--;
        renderQuizTaking();
      }
    }

    function startTimer() {
      clearInterval(quizTimer);
      updateTimerDisplay();
      quizTimer = setInterval(() => {
        timeRemaining--;
        updateTimerDisplay();
        if (timeRemaining <= 0) {
          clearInterval(quizTimer);
          submitQuiz();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const timerEl = document.getElementById('timer-text');
      const timerDisplay = document.getElementById('timer-display');
      if (timerEl) {
        const minutes = Math.floor(Math.max(0, timeRemaining) / 60);
        const seconds = Math.max(0, timeRemaining) % 60;
        timerEl.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
      }
      if (timerDisplay && timeRemaining < 60) {
        timerDisplay.classList.add('timer-warning');
      }
    }

    async function submitQuiz() {
      clearInterval(quizTimer);
      
      let score = 0;
      const total = quizQuestions.length;
      const answersToSubmit = [];
      
      quizQuestions.forEach((q, i) => {
        const userAnswer = userAnswers[i];
        const isCorrect = userAnswer === q.correct;
        if (isCorrect) score++;
        answersToSubmit.push({
          question: q.question,
          userAnswer: userAnswer !== undefined ? (q.options ? q.options[userAnswer] : 'No answer') : 'Not answered',
          correctAnswer: q.options ? q.options[q.correct] : 'N/A',
          isCorrect,
          explanation: q.explanation || ''
        });
      });

      const percentage = Math.round((score / total) * 100);
      const passed = percentage >= 70;
      const timeTaken = Math.round((new Date() - quizStartTime) / 1000);

      try {
        await apiCall('complete_quiz', {
          quiz_id: currentQuiz.id,
          score,
          total,
          percentage,
          passed,
          answers: answersToSubmit,
          time_taken: timeTaken
        });
      } catch(e) {
        console.error('Failed to save quiz results:', e);
      }

      renderResults(score, total, percentage, passed, answersToSubmit, timeTaken);
    }

    function renderResults(score, total, percentage, passed, answers, timeTaken) {
      const container = document.getElementById('quiz-content');
      const remark = getRandomRemark(passed);
      const minutes = Math.floor(timeTaken / 60);
      const seconds = timeTaken % 60;
      
      let answersHTML = answers.map((a, i) => {
        const q = quizQuestions[i];
        return '<div class="question-card" style="padding:1.2rem;">' +
          '<p style="font-weight:600;color:var(--clr-white);margin-bottom:0.75rem;">' + (i + 1) + '. ' + esc(q.question) + '</p>' +
          '<p style="font-size:0.85rem;margin-bottom:0.25rem;">Your answer: <span style="color:' + (a.isCorrect ? '#10b981' : '#ef4444') + ';font-weight:600;">' + esc(a.userAnswer) + '</span> ' + (a.isCorrect ? '<i class="fa-solid fa-check" style="color:#10b981;"></i>' : '<i class="fa-solid fa-xmark" style="color:#ef4444;"></i>') + '</p>' +
          (!a.isCorrect ? '<p style="font-size:0.85rem;margin-bottom:0.5rem;">Correct answer: <span style="color:#10b981;font-weight:600;">' + esc(a.correctAnswer) + '</span></p>' : '') +
          (a.explanation ? '<div class="explanation-box"><strong><i class="fa-solid fa-lightbulb"></i> Explanation:</strong> ' + esc(a.explanation) + '</div>' : '') +
          (!a.isCorrect ? '<div class="explanation-box" style="margin-top:0.3rem;"><strong><i class="fa-solid fa-circle-info"></i> Why your answer was ' + (a.userAnswer === 'Not answered' ? 'skipped' : 'incorrect') + ':</strong> ' + (a.userAnswer === 'Not answered' ? 'You did not select an answer for this question. The correct answer is shown above.' : 'The answer you selected is not correct. Review the explanation above to understand the correct concept.') + '</div>' : '') +
        '</div>';
      }).join('');

      container.innerHTML = '<div class="quiz-taking-container">' +
        '<div class="card result-card">' +
          (passed ? '<i class="fa-solid fa-trophy text-5xl" style="color:var(--clr-magenta);margin-bottom:1rem;"></i>' : '<i class="fa-solid fa-book-open text-5xl" style="color:var(--clr-cyan);margin-bottom:1rem;"></i>') +
          '<h2 style="font-family:\'Playfair Display\',serif;font-size:1.5rem;color:var(--clr-white);margin-bottom:0.5rem;">' + (passed ? 'Congratulations!' : 'Quiz Complete') + '</h2>' +
          '<div class="result-score">' + percentage + '%</div>' +
          '<p style="color:var(--clr-text-dim);margin:0.5rem 0;">' + score + ' out of ' + total + ' correct</p>' +
          '<p style="font-size:0.8rem;color:var(--clr-text-muted);margin-bottom:0.5rem;">Time taken: ' + minutes + 'm ' + seconds + 's</p>' +
          (passed ? '<span class="difficulty-badge difficulty-easy" style="font-size:0.8rem;"><i class="fa-solid fa-check"></i> Passed</span>' : '<span class="difficulty-badge difficulty-hard" style="font-size:0.8rem;"><i class="fa-solid fa-xmark"></i> Failed — Try again tomorrow</span>') +
          '<p class="result-remark">' + remark + '</p>' +
        '</div>' +
        '<h3 style="font-family:\'Playfair Display\',serif;font-size:1.2rem;color:var(--clr-white);margin:2rem 0 1rem;">Detailed Review</h3>' +
        answersHTML +
        '<div style="text-align:center;margin-top:2rem;">' +
          '<button class="btn-primary" onclick="loadQuizzes()"><i class="fa-solid fa-list"></i> Back to Quizzes</button>' +
        '</div>' +
      '</div>';
    }

    window.showAuthForm = function(mode) {
      const existing = document.getElementById('auth-modal'); if (existing) existing.remove();
      const modal = document.createElement('div'); modal.id = 'auth-modal';
      modal.style.cssText = 'position:fixed;inset:0;z-index:300;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.8);';
      modal.innerHTML = '<div style="background:var(--clr-navy-card);border:2px solid var(--clr-cyan);border-radius:var(--radius-lg);padding:2rem;max-width:380px;width:90%;position:relative;backdrop-filter:blur(20px);"><button id="close-auth" style="position:absolute;top:0.5rem;right:0.5rem;background:none;border:none;color:var(--clr-text-dim);cursor:pointer;font-size:1.2rem;">✕</button><h3 style="color:var(--clr-cyan);margin-bottom:1.2rem;text-align:center;">' + (mode==='signin'?'Sign In':'Create Account') + '</h3><form id="auth-form" style="display:flex;flex-direction:column;gap:1rem;"><input type="email" id="auth-email" class="form-input" placeholder="Email" required><input type="password" id="auth-password" class="form-input" placeholder="Password (min 6 chars)" minlength="6" required><button type="submit" class="btn-primary" style="justify-content:center;">' + (mode==='signin'?'Sign In':'Create Account') + '</button></form><p style="text-align:center;margin-top:1rem;color:var(--clr-text-dim);font-size:0.9rem;">' + (mode==='signin'?"No account? <a href='#' id='switch-mode' style='color:var(--clr-magenta);'>Sign up</a>":"Have account? <a href='#' id='switch-mode' style='color:var(--clr-magenta);'>Sign in</a>") + '</p><p id="auth-error" style="color:#ff4444;text-align:center;margin-top:0.5rem;display:none;"></p></div>';
      document.body.appendChild(modal);
      document.getElementById('close-auth').onclick = () => modal.remove();
      modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
      document.getElementById('switch-mode').onclick = (e) => { e.preventDefault(); modal.remove(); showAuthForm(mode==='signin'?'signup':'signin'); };
      document.getElementById('auth-form').onsubmit = async (e) => {
        e.preventDefault(); const email = document.getElementById('auth-email').value.trim(), password = document.getElementById('auth-password').value, errEl = document.getElementById('auth-error'); errEl.style.display = 'none';
        try {
          const action = mode === 'signin' ? 'signin' : 'signup', data = await apiCall(action, { email, password });
          if (data.session) { localStorage.setItem('sb-token', data.session.access_token); localStorage.setItem('sb-email', data.user.email); modal.remove(); loadQuizzes(); }
          else if (mode === 'signup') { errEl.textContent = 'Check your email to confirm signup.'; errEl.style.display = 'block'; }
        } catch (err) { errEl.textContent = err.message; errEl.style.display = 'block'; }
      };
    };

    function initUI() {
      const tt = document.getElementById('theme-toggle'), icon = tt.querySelector('i');
      if (localStorage.getItem('theme') === 'dark') { document.body.classList.add('dark-mode'); icon.classList.remove('fa-moon'); icon.classList.add('fa-sun'); }
      tt.onclick = () => { document.body.classList.toggle('dark-mode'); const isDark = document.body.classList.contains('dark-mode'); if (isDark) { icon.classList.remove('fa-moon'); icon.classList.add('fa-sun'); localStorage.setItem('theme','dark'); } else { icon.classList.remove('fa-sun'); icon.classList.add('fa-moon'); localStorage.setItem('theme','light'); } };
    }

    document.addEventListener('DOMContentLoaded', async () => {
      document.getElementById('current-year').textContent = new Date().getFullYear();
      initUI();
      await loadNavigation();
      await loadQuizzes();
    });
  </script>
</body>
</html>
