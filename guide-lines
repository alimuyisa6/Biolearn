<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Feature Test — AliverBiopharm</title><style>body{font-family:sans-serif;background:#0d2e2e;color:#e0f0ff;padding:20px;max-width:600px;margin:0 auto}.card{background:rgba(255,255,255,0.1);border-radius:12px;padding:20px;margin:10px 0}.green{color:#10b981}.red{color:#ef4444}.cyan{color:#0ab5b5}pre{background:rgba(0,0,0,0.3);padding:10px;border-radius:8px;overflow-x:auto;font-size:12px}button{padding:12px 24px;background:#0ab5b5;color:#fff;border:none;border-radius:8px;cursor:pointer;font-weight:700}</style></head><body><h1>🔧 Feature Test Page</h1><p>This page tests if app features load from the API.</p><button onclick="testFeatures()">Test Features API</button><div id="results"><p>Click the button to test...</p></div><script>
var API_BASE='/api/query';
async function testFeatures(){
  document.getElementById('results').innerHTML='<p class="cyan">Fetching features via GET...</p>';
  try{
    var token=localStorage.getItem('sb-token');
    var h={};if(token)h['Authorization']='Bearer '+token;
    var r=await fetch(API_BASE+'?action=get_app_features&page_id=quiz',{method:'GET',headers:h});
    var s=r.status;
    var j=await r.json();
    var html='<div class="card"><strong>Status:</strong> '+s+'<br><strong>Type:</strong> '+(Array.isArray(j)?'Array ('+j.length+' items)':typeof j)+'</div>';
    if(Array.isArray(j)&&j.length>0){
      html+='<h3>✅ Features Loaded:</h3>';
      j.forEach(function(f,i){
        html+='<div class="card"><strong>#'+(i+1)+'</strong> '+f.feature_key+'<br><span class="'+(f.is_enabled?'green':'red')+'">is_enabled: '+f.is_enabled+'</span><br><span class="'+(f.user_enabled?'green':'red')+'">user_enabled: '+f.user_enabled+'</span></div>';
      })
    }else if(Array.isArray(j)&&j.length===0){
      html+='<p class="red">❌ Empty array returned. No features in database.</p>'
    }else{
      html+='<pre>'+JSON.stringify(j,null,2)+'</pre>'
    }
    document.getElementById('results').innerHTML=html
  }catch(e){
    document.getElementById('results').innerHTML='<p class="red">❌ Error: '+e.message+'</p>'
  }
}
</script></body></html>
